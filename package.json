{
	"name": "charlens",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"pnpm": {
		"onlyBuiltDependencies": [
			"protobufjs",
			"sharp"
		]
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && oxlint",
		"lint:design": "oxlint",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.60.0",
		"@shadcn/lint": "^0.1.3",
		"@sveltejs/adapter-node": "^2.1.2",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"dotenv": "^18.0.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"oxlint": "^1.83.0",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0",
		"@xenova/transformers": "^2.17.2",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"cn": "^0.3.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"rss-parser": "^3.13.0",
		"sanitize-html": "^2.17.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
