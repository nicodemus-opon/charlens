# Drizzle (local vite dev; compose/Coolify inject real values at runtime)
# NOTE: matches the `db` service defaults below (POSTGRES_USER/DB=charlens).
# If your local pgdata volume was created with older root/local credentials,
# either keep those here or `docker compose down -v` to start fresh.
DATABASE_URL="postgres://charlens:secret@localhost:7056/charlens"

# App (vite dev picks up PORT from .env)
PORT="7786"
ORIGIN="http://localhost:7786"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Self-hosted multi-user: set to 1 to close registration once every account
# has been created (existing users can still sign in).
AUTH_DISABLE_SIGNUP=""

# RSSHub (self-hosted via docker-compose `rsshub` service on :1200).
# Local dev hits the host port; inside compose networking use http://rsshub:1200.
RSSHUB_BASE_URL="http://localhost:1200"
RSSHUB_ENABLED="1"
RSSHUB_TIMEOUT_MS="15000"

# Automated full-text backfill (runs after each scheduled feed refresh).
# Scrapes truncated articles into content_html; empty/failed scrapes get the
# same 7-day cooldown as the manual endpoint. Manual "Load full text" still works.
FULLTEXT_AUTO_ENABLED="1"
FULLTEXT_MAX_PER_RUN="10"
FULLTEXT_CONCURRENCY="3"

# Background fetch: server refreshes every stale feed on this cadence.
# 15 matches the 15-minute staleness window in rss/refresh.
FEED_REFRESH_INTERVAL_MIN="15"
FEED_REFRESH_SCHEDULER_ENABLED="1"

# Local-only auto-tagging/topics (no external services; runs after each
# scheduled refresh). Tags up to ENRICH_MAX_PER_RUN un-enriched articles per
# run, ENRICH_CONCURRENCY at a time; failures are stamped so they are not
# retried every tick.
ENRICH_AUTO_ENABLED="1"
ENRICH_MAX_PER_RUN="25"
ENRICH_CONCURRENCY="3"

# Local embeddings (Transformers.js all-MiniLM-L6-v2, 384-dim, CPU-only).
# The ~80MB ONNX model downloads once into EMBED_CACHE_DIR — persist it via
# the embed-cache volume so redeploys don't re-download. EMBED_ENABLED=0
# keeps keyword-only mode. EMBED_MAX_PER_RUN caps newly embedded articles
# per scheduler tick (model stays resident after first load).
EMBED_ENABLED="1"
EMBED_MODEL="Xenova/all-MiniLM-L6-v2"
EMBED_CACHE_DIR="/app/.cache/hf"
EMBED_BATCH="16"
EMBED_MAX_PER_RUN="50"
